--ВР таблица 2
create table if not exists WR_table2(
	height_200 int,
	height_400 int,
	height_800 int,
	height_1200 int,
	height_1600 int,
	height_2000 int,
	height_2400 int,
	height_3000 int,
	height_4000 int);

comment on table WR_table2 is 'Таблица со скоростями среднего ветра в зависимости от дальности сноса ветровых пуль';
comment on column WR_table2.height_200 is 'Скорость на высоте 200';
comment on column WR_table2.height_400 is 'Скорость на высоте 400';
comment on column WR_table2.height_800 is 'Скорость на высоте 800';
comment on column WR_table2.height_1200 is 'Скорость на высоте 1200';
comment on column WR_table2.height_1600 is 'Скорость на высоте 1600';
comment on column WR_table2.height_2000 is 'Скорость на высоте 2000';
comment on column WR_table2.height_2400 is 'Скорость на высоте 2400';
comment on column WR_table2.height_3000 is 'Скорость на высоте 3000';
comment on column WR_table2.height_4000 is 'Скорость на высоте 4000';


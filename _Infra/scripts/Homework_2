--запрос
select 'Измерение ' || packs.id || ' сделано в ' || packs.DDHHM || ' на ' || equipment_types.name || ' пользователем ' || users.name || ' ' || users.surname || ' ' || job_titles.name as measurement_from_logs from packs, users, job_titles, equipment_types
where
	packs.equipment_type_id = equipment_types.id and
	packs.user_id = users.id and
	users.job_title_id = job_titles.id;


--ddl
--таблицы
create table if not exists packs( --что это вообще? логи? группы солдат? что?
	id int,
	user_id int,
	equipment_type_id int,
	DDHHM int,
	HHHH int,
	BBBTT int
);

create table if not exists users( --так же, как на прошлой паре
	id int,
	name text,
	surname text,
	job_title_id int
);

create table if not exists job_titles( --так же, как на прошлой паре
	id int,
	name text
);

create table if not exists parameters( --из тз
	id int,
	name text,
	default_value int,
	unit text
);

create table if not exists equipment_types( --айди и название?
	id int,
	name text
);

--тестовые данные
insert into parameters(id, name, default_value, unit) values('1', 'Высота Метеопоста', '100', 'Метр');

-- Миграционный скрипт
-- 2026-09-23
drop table if exists military_ranks;
drop table if exists employees;
drop table if exists measurment_types;
drop table if exists measurement_values;
drop table if exists parameter_types;
drop table if exists batches;
drop table if exists parameters_measurements;


-- 1. Справочник должностей military_ranks
-- Редактируем таблицу
alter table job_titles rename to military_ranks;
alter table military_ranks rename column name to description;
alter table military_ranks alter column description type character varying(255);

comment on table military_ranks is 'Справочник Должностей';
comment on column military_ranks.id is 'Уникальный Код';
comment on column military_ranks.description is 'Описание';

-- 2. Пользователи employees
-- Редактируем таблицу
alter table users rename to employees;
alter table employees drop column surname;
alter table employees add column birthday timestamp;
alter table employees rename column job_title_id to military_rank_id;

comment on table employees is 'Пользователи';
comment on column employees.id is 'Уникальный Код';
comment on column employees.name is 'Имя';
comment on column employees.birthday is 'Дата Рождения';
comment on column employees.military_rank_id is 'Уникальный Код Должности';

-- Дополняем данные
update employees set name = 'Выборов Виталий Алексеевич', birthday = '2007-10-10' where name = 'Виталий';
update employees set name = 'Геец Герман Константинович', birthday = '2000-01-01' where name = 'Герман';
update employees set name = 'Сатин Роман Юрьевич', birthday = '2000-01-01' where name = 'Роман';
update employees set name = 'Жаренов Кирилл Алексеевич', birthday = '2000-01-01' where name = 'Кирилл';

-- Заполняем данные
insert into employees(id, name, birthday, military_rank_id)  
values(5, 'Воловиков Александр Сергеевич','1978-06-24', 2);


-- 3. Справочник устройств для измерения measurment_types
-- Редактируем таблицу
alter table equipment_types rename to measurment_types;
alter table measurment_types add column short_name character varying(255);
alter table measurment_types rename column name to description;

comment on table measurment_types is 'Измерительное Оборудование';
comment on column measurment_types.id is 'Уникальный Код';
comment on column measurment_types.short_name is 'Краткое Наименование';
comment on column measurment_types.description is 'Описание';

-- Дополняем данные
update measurment_types set short_name = 'ДМК' where description = 'Десантный Метео Комплекс';
update measurment_types set short_name = 'ВР' where description = 'Ветровое ружье';

-- 4. Справочник единиц измерения measurement_values
-- Создаём таблицу
create table measurement_values
(
	id integer,
	description character varying(50)
);

comment on table measurement_values is 'Справочник Единиц Измерения';
comment on column measurement_values.id is 'Уникальный Код';
comment on column measurement_values.description is 'Описание';

-- Заполняем данные
insert into measurement_values(id, description)
values(1,'Метр Над Уровнем Моря'),
	(2,'Градус Цельсия'),
	(3,'Миллиметр Ртутного Столба'),
	(4,'Большое Деление Угломера'),
	(5,'Метр В Секунду'),
	(6,'Метр Горизонтальный');


-- 5. Справочник параметров parameter_types
-- Редактируем таблицу
alter table parameters rename to parameter_types;
alter table parameter_types alter column name type character varying(255);
alter table parameter_types rename column default_value to measurement_value_id;
alter table parameter_types drop column unit;

comment on table parameter_types is 'Параметры Измерений';
comment on column parameter_types.id is 'Уникальный Код';
comment on column parameter_types.name is 'Наименование';
comment on column parameter_types.measurement_value_id is 'Уникальный Код Единицы Измерения';

-- Дополняем данные
update parameter_types set measurement_value_id = '1' where id = '1';
update parameter_types set measurement_value_id = '2' where id = '2';
update parameter_types set measurement_value_id = '3' where id = '3';
update parameter_types set measurement_value_id = '4' where id = '4';
update parameter_types set measurement_value_id = '5' where id = '5';
update parameter_types set measurement_value_id = '6' where id = '6';


-- 6. Пачки batches
-- Редактируем таблицу
alter table packs rename to batches;
alter table batches rename column user_id to employee_id;
alter table batches drop column equipment_type_id; --Я не уверен, надо ли оставлять этот столбец
--alter table batches rename column equipment_type_id to measurment_type_id;
alter table batches alter column ddhhm type character varying(255);
alter table batches drop column hhhh;
alter table batches drop column bbbtt;

comment on table batches is 'Лог С Датой Измерения Параметра';
comment on column batches.id is 'Уникальный Код';
comment on column batches.employee_id is 'Уникальный Код Пользователя';
--comment on column batches.measurment_type_id is 'Уникальный Код Измерительного Оборудования';
comment on column batches.ddhhm is 'Дата И Время Записи Параметра';

-- Дополняем данные
update batches set ddhhm = '27194' where id = '1';
update batches set ddhhm = '27195' where id = '2';
update batches set ddhhm = '27200' where id = '3';
update batches set ddhhm = '27201' where id = '4';
update batches set ddhhm = '27202' where id = '5';


-- 7. Таблица с параметрами parameters_measurements
create table parameters_measurements
(
    id integer,
	batch_id integer,
	parameter_type_id integer,
	value text
);

comment on table parameters_measurements is 'Таблица с измерениями параметров';
comment on column parameters_measurements.id is 'Уникальный код';
comment on column parameters_measurements.batch_id is 'Уникальный код пачки';
comment on column parameters_measurements.parameter_type_id is 'Уникальный код параметра';
comment on column parameters_measurements.value is 'Значение измеренного параметра';

-- Заполняем данные
insert into parameters_measurements(id, batch_id, parameter_type_id, value)
values(1,  1, 1, '60'), (2,  1, 2, '15'), (3,  1, 3, '750'), (4,  1, 4, '4'), (5,  1, 5, '2'), (6,  1, 6, '0'),
	  (7,  2, 1, '60'), (8,  2, 2, '14'), (9,  2, 3, '740'), (10, 2, 4, '7'), (11, 2, 5, '3'), (12, 2, 6, '0'),
	  (13, 3, 1, '60'), (14, 3, 2, '14'), (15, 3, 3, '745'), (16, 3, 4, '9'), (17, 3, 5, '5'), (18, 3, 6, '0'),
	  (19, 4, 1, '60'), (20, 4, 2, '13'), (21, 4, 3, '750'), (22, 4, 4, '9'), (23, 4, 5, '4'), (24, 4, 6, '0'),
	  (25, 5, 1, '60'), (26, 5, 2, '11'), (27, 5, 3, '760'), (28, 5, 4, '9'), (29, 5, 5, '4'), (30, 5, 6, '0')
	  ;

---------------------------------------------------
-- Итоговый запрос
---------------------------------------------------

select 'Измерение ' || batches.id || ' сделано в ' || batches.ddhhm || ' пользователем ' || employees.name || '. ' || parameter_types.name || ' равен ' || parameters_measurements.value || ' ' || measurement_values.description 
as measurement_from_logs
from batches, employees, parameter_types, parameters_measurements, measurement_values
where
	    parameters_measurements.parameter_type_id = parameter_types.id
	and parameters_measurements.batch_id = batches.id
	and batches.employee_id = employees.id
	and parameter_types.measurement_value_id = measurement_values.id;
-- Функции рассчёта поправки температуры
do $do$
begin
-- удаление создаваемого
	drop type if exists interpolation_temps cascade;
	drop function if exists find_interpolation_temps (decimal(3,1)) cascade;
	drop function if exists temp_linear_interpolate (decimal(3,1), interpolation_temps) cascade;
-- Тип данных для интерполяции
	create type interpolation_temps as (
       	x0 decimal(3,1),
       	y0 decimal(3,1),
      	x1 decimal(3,1),
       	y1 decimal(3,1));
-- Функция рассчёта интервала интерполяции
	create or replace function find_interpolation_temps (temperature_func decimal(3,1))
	returns interpolation_temps
	language plpgsql
	as $func1$
		declare temp_interval interpolation_temps;
		begin -- нахождение интервала интерполяции
			select
	           	x0, y0, x1, y1
	       	into temp_interval
	       	from (
	           	select
	               	(select temperature from temperature_calc_1 where temperature <= temperature_func order by temperature desc limit 1) as x0,
	               	(select correction from temperature_calc_1 where temperature <= temperature_func order by temperature desc limit 1) as y0,
	               	(select temperature from temperature_calc_1 where temperature >= temperature_func order by temperature asc limit 1) as x1,
	               	(select correction from temperature_calc_1 where temperature >= temperature_func order by temperature asc limit 1) as y1
	       	) points;

			return temp_interval;
		end;
	$func1$;
--Функция рассчёта самой интерполяции
	create or replace function temp_linear_interpolate (temperature_func decimal(3,1), temp_interval interpolation_temps)
	returns decimal(3,1)
	language plpgsql
	as $func2$
		begin -- рассчёт поправки
			if temperature_func < 0 then --температура < 0
				return 0;
			elsif temp_interval.x0 = temp_interval.x1 then -- температура совпадает с граничащим значением (деление на 0)
				return temp_interval.y0;
			end if;
			
			return temp_interval.y0 + (temperature_func - temp_interval.x0) * (temp_interval.y1 - temp_interval.y0) / (temp_interval.x1 - temp_interval.x0);
		end;
	$func2$;

	
end $do$;
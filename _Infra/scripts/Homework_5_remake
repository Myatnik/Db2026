-- 3. Связи и ограничения
begin;
alter table military_ranks add primary key (id);
alter table employees add primary key (id);
alter table measurment_types add primary key (id);
alter table parameter_values add primary key (id);
alter table parameter_types add primary key (id);
alter table batches add primary key (id);
alter table parameters_measurements add primary key (id);
alter table temperature_calc_1 add primary key (id);

alter table employees add foreign key (military_rank_id) references military_ranks (id);
alter table parameter_types add foreign key (parameter_value_id) references parameter_values (id);
alter table batches add foreign key (employee_id) references employees (id);
alter table parameters_measurements
	add foreign key (batch_id) references batches (id),
	add foreign key (parameter_type_id) references parameter_types (id);

alter table military_ranks alter column description set not null;
alter table employees
	alter column name set not null,
	alter column birthday set not null,
	alter column military_rank_id set not null;
alter table measurment_types
	alter column short_name set not null,
	alter column description set not null;
alter table parameter_values alter column description set not null;
alter table parameter_types
	alter column name set not null,
	alter column parameter_value_id set not null;
alter table batches
	alter column employee_id set not null,
	alter column ddhhm set not null;
alter table parameters_measurements
	alter column batch_id set not null,
	alter column parameter_type_id set not null,
	alter column value set not null;
alter table temperature_calc_1
	alter column temperature set not null,
	alter column correction set not null;
commit;
-- homework_4_dml.sql
-- DML-скрипт: добавление тестовых измерений.
-- Основано на схеме после homework_3.
-- Идемпотентность: удаляем только строки с id >= 101, чтобы можно было запускать повторно.

DELETE FROM parameters_measurements WHERE id >= 101;
DELETE FROM batches WHERE id >= 101;

-- Добавляем пачки измерений.
-- После homework_3 уже есть 5 пачек:
-- employee_id = 1 -> 2 пачки
-- employee_id = 2 -> 1 пачка
-- employee_id = 3 -> 1 пачка
-- employee_id = 4 -> 1 пачка
-- employee_id = 5 -> 0 пачек
-- Добавляем так, чтобы у каждого сотрудника стало по 2 пачки.
INSERT INTO batches(id, employee_id, ddhhm) VALUES
(101, 2, '28100'),
(102, 3, '28110'),
(103, 4, '28120'),
(104, 5, '28130'),
(105, 5, '28140');

-- Добавляем измерения по 6 параметрам в каждую новую пачку.
